{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "product-db-data",
        "namespace": "store"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "product-db",
        "namespace": "store"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "product-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "product-db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "product-db",
                "image": "postgres:16-alpine",
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "product"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "products"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "store-secrets",
                        "key": "PRODUCT_DB_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "product",
                      "-d",
                      "products"
                    ]
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "product-db-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "product-db",
        "namespace": "store"
      },
      "spec": {
        "selector": {
          "app": "product-db"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "order-db-data",
        "namespace": "store"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "order-db",
        "namespace": "store"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "order-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "order-db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "order-db",
                "image": "postgres:16-alpine",
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "orders"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "orders"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "store-secrets",
                        "key": "ORDER_DB_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "orders",
                      "-d",
                      "orders"
                    ]
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "order-db-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "order-db",
        "namespace": "store"
      },
      "spec": {
        "selector": {
          "app": "order-db"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "redis",
        "namespace": "store"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "redis"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7-alpine",
                "command": [
                  "sh",
                  "-c",
                  "exec redis-server --requirepass \"$REDIS_PASSWORD\""
                ],
                "env": [
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "store-secrets",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 6379
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis",
        "namespace": "store"
      },
      "spec": {
        "selector": {
          "app": "redis"
        },
        "ports": [
          {
            "port": 6379,
            "targetPort": 6379
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "rabbit-data",
        "namespace": "store"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "rabbitmq",
        "namespace": "store"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "rabbitmq"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rabbitmq"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "rabbitmq",
                "image": "rabbitmq:4-alpine",
                "env": [
                  {
                    "name": "RABBITMQ_DEFAULT_USER",
                    "value": "store"
                  },
                  {
                    "name": "RABBITMQ_DEFAULT_PASS",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "store-secrets",
                        "key": "RABBITMQ_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS",
                    "value": "+S 2:2"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5672
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/rabbitmq"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "startupProbe": {
                  "tcpSocket": {
                    "port": 5672
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 3
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 5672
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "hostname": "rabbitmq",
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "rabbit-data"
                }
              }
            ],
            "initContainers": [
              {
                "name": "cookie-permissions",
                "image": "rabbitmq:4-alpine",
                "securityContext": {
                  "runAsUser": 0
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/rabbitmq"
                  }
                ],
                "command": [
                  "sh",
                  "-c",
                  "if [ -f /var/lib/rabbitmq/.erlang.cookie ]; then chown rabbitmq:rabbitmq /var/lib/rabbitmq/.erlang.cookie; chmod 400 /var/lib/rabbitmq/.erlang.cookie; fi"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rabbitmq",
        "namespace": "store"
      },
      "spec": {
        "selector": {
          "app": "rabbitmq"
        },
        "ports": [
          {
            "port": 5672,
            "targetPort": 5672
          }
        ]
      }
    }
  ]
}